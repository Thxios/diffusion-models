{
  "output_dir": "outputs/rf_cifar10_attn",
  "wandb_run_name": "rf_cifar10_attn",
  "max_steps": 1000000,
  "logging_steps": 50,
  "eval_steps": 2000,
  "save_steps": 20000,
  "eval_n_examples": 40,
  "guidance_scale": 1.0,
  "fid_eval_steps": 20000,
  "fid_ema": true,
  "fid_reference_dataset": "cifar10-train",
  "fid_n_examples": 10000,
  "generation_batch_size": 256,
  "inception_batch_size": 512,
  "adjust_fid_n": true,
  "fid_adjust_subsets": [
    4000,
    6000,
    8000,
    10000
  ],
  "batch_size": 128,
  "lr": 0.0002,
  "lr_scheduler": "linear",
  "lr_warmup_steps": 5000,
  "optimizer": "adamw",
  "clip_grad_norm": 1.0,
  "use_ema": true,
  "ema_inv_gamma": 1.0,
  "ema_power": 0.75,
  "dataset": "cifar10",
  "dataset_dir": "~/datasets",
  "augmentations": [
    "RandomHorizontalFlip"
  ],
  "dataloader_num_workers": 2,
  "seed": 42,
  "bf16": true,
  "p_uncond": 0.2,
  "model_type": "unet",
  "model_cfg": {
    "in_channels": 3,
    "out_channels": 3,
    "down_block_types": [
      "UNetAttnDownBlock",
      "UNetAttnDownBlock",
      "UNetAttnDownBlock"
    ],
    "up_block_types": [
      "UNetAttnUpBlock",
      "UNetAttnUpBlock",
      "UNetAttnUpBlock"
    ],
    "block_out_channels": [
      256,
      256,
      256
    ],
    "n_blocks_per_layer": 2,
    "mid_attention": true,
    "n_dim_attention_head": 8,
    "norm_groups": 32,
    "activation": "silu",
    "time_encoding_dim": 256,
    "embedding_dim": 256,
    "embedding_mixing": "scale_shift",
    "n_class_embeddings": 10,
    "dropout": 0.13,
    "downsample_use_conv": true,
    "upsample_use_conv": true
  },
  "scheduler_type": "rectified_flow",
  "scheduler_cfg": {
    "n_steps": 1000
  },
  "sampler_type": "euler",
  "sampler_cfg": {
    "n_steps": 50,
    "pbar": true
  }
}